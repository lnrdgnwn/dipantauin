        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/node-cron": "^3.0.11",
        "@vitest/coverage-v8": "^4.1.11",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0",
        "vitest": "^4.1.11"
    }
}
