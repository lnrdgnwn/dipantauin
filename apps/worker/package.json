{
    "name": "@dipantauin/worker",
    "version": "1.0.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./trackers": {
            "types": "./src/trackers/index.ts",
            "default": "./dist/trackers/index.js"
        }
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
