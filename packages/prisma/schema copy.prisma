generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  UNAVAILABLE
  ERROR
}

enum PriceCheckStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  PRICE_DROP
  PRICE_INCREASE
  TARGET_REACHED
  SYSTEM
}


// ======================================================
// USERS
// ======================================================

model User {
  id            String     @id @default(uuid()) @db.Char(36)
  email         String     @unique @db.VarChar(255)
  name          String?    @db.VarChar(255)
  passwordHash  String     @db.VarChar(255)
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  userProducts  UserProduct[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@index([role])
  @@map("users")
}

// ======================================================
// REFRESH TOKENS
// ======================================================

model RefreshToken {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)

  tokenHash String @unique @db.VarChar(255)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])
  @@index([expiresAt])

  @@map("refresh_tokens")
}

// ======================================================
// PLANS
// ======================================================

model Plan {
  id               String   @id @default(uuid()) @db.Char(36)
  code             String   @unique @db.VarChar(50)
  name             String   @db.VarChar(100)

  price            Decimal  @db.Decimal(12, 2)
  currency         String   @default("IDR") @db.Char(3)

  maxProducts      Int
  checkIntervalMin Int

  isActive         Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}


// ======================================================
// SUBSCRIPTIONS
// ======================================================

model Subscription {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  planId String @db.Char(36)

  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  plan Plan @relation(
    fields: [planId],
    references: [id],
    onDelete: Restrict
  )

  payments Payment[]

  @@index([userId, status])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])

  @@map("subscriptions")
}


// ======================================================
// PAYMENTS
// ======================================================

model Payment {
  id String @id @default(uuid()) @db.Char(36)

  userId         String  @db.Char(36)
  subscriptionId String? @db.Char(36)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("IDR") @db.Char(3)

  provider                String @db.VarChar(50)
  providerTransactionId   String @db.VarChar(255)

  status PaymentStatus @default(PENDING)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Restrict
  )

  subscription Subscription? @relation(
    fields: [subscriptionId],
    references: [id],
    onDelete: SetNull
  )

  events PaymentEvent[]

  @@unique([provider, providerTransactionId])

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])

  @@map("payments")
}


// ======================================================
// PAYMENT EVENTS
// ======================================================

model PaymentEvent {
  id String @id @default(uuid()) @db.Char(36)

  paymentId String @db.Char(36)

  eventId   String @unique @db.VarChar(255)
  eventType String @db.VarChar(100)

  payload Json

  status      PaymentEventStatus @default(RECEIVED)
  processedAt DateTime?

  createdAt DateTime @default(now())

  payment Payment @relation(
    fields: [paymentId],
    references: [id],
    onDelete: Cascade
  )

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])

  @@map("payment_events")
}


// ======================================================
// PRODUCTS
// ======================================================

model Product {
  id String @id @default(uuid()) @db.Char(36)

  platform           String  @db.VarChar(50)
  externalProductId  String? @db.VarChar(255)

  url          String @db.Text
  canonicalUrl String? @db.Text

  name       String  @db.Text
  sellerName String? @db.VarChar(255)

  currency     String  @default("IDR") @db.Char(3)
  currentPrice Decimal @db.Decimal(15, 2)

  lastCheckedAt DateTime?
  nextCheckAt   DateTime?

  status ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProducts UserProduct[]
  priceHistory PriceHistory[]
  priceChecks  PriceCheck[]

  @@unique([platform, externalProductId])
  
  @@index([platform])
  @@index([nextCheckAt])
  @@index([status])
  @@index([lastCheckedAt])

  @@map("products")
}


// ======================================================
// USER PRODUCTS
// ======================================================

model UserProduct {
  id String @id @default(uuid()) @db.Char(36)

  userId    String @db.Char(36)
  productId String @db.Char(36)

  targetPrice Decimal? @db.Decimal(15, 2)

  notifyOnDrop     Boolean @default(true)
  notifyOnIncrease Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  product Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  notifications Notification[]

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([isActive])

  @@map("user_products")
}


// ======================================================
// PRICE HISTORY
// ======================================================

model PriceHistory {
  id BigInt @id @default(autoincrement()) @db.BigInt

  productId String @db.Char(36)

  price    Decimal  @db.Decimal(15, 2)
  currency String   @default("IDR") @db.Char(3)

  checkedAt DateTime

  product Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  @@index([productId, checkedAt])
  @@index([checkedAt])

  @@map("price_history")
}


// ======================================================
// PRICE CHECKS
// ======================================================

model PriceCheck {
  id BigInt @id @default(autoincrement()) @db.BigInt

  productId String @db.Char(36)

  startedAt   DateTime
  completedAt DateTime?

  status PriceCheckStatus

  price       Decimal? @db.Decimal(15, 2)
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  product Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  @@index([productId, createdAt])
  @@index([status])
  @@index([createdAt])

  @@map("price_checks")
}


// ======================================================
// NOTIFICATIONS
// ======================================================

model Notification {
  id String @id @default(uuid()) @db.Char(36)

  userId        String @db.Char(36)
  userProductId String @db.Char(36)

  type    NotificationType
  title   String @db.VarChar(255)
  message String @db.Text

  isRead Boolean @default(false)
  sentAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  userProduct UserProduct @relation(
    fields: [userProductId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId, isRead])
  @@index([userProductId])
  @@index([type])
  @@index([createdAt])

  @@map("notifications")
}